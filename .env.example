# Copy this file to ".env", fill in ONE of the options below, and never commit or share ".env".

# Option 1: any OpenAI-compatible provider. Example: Google Gemini (free key from https://aistudio.google.com/apikey)
LLM_API_KEY=your_provider_key_here
LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL defaults to Gemini's endpoint. Override it for other providers, e.g.
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Option 2: Hugging Face Inference Providers (requires pre-paid credits or PRO). Leave LLM_API_KEY unset to use this.
# HF_TOKEN=hf_your_token_here
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
